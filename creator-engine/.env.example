# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL (OAuth redirects, Stripe return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret for /api/cron/sync (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# TikTok Login Kit (scopes: user.info.basic, user.info.stats, video.list)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram API with Instagram Login (Meta app → Instagram → API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# YouTube Data API v3 key (public video statistics)
YOUTUBE_API_KEY=

# Stripe Connect
STRIPE_SECRET_KEY=
# Publishable key (pk_test_… / pk_live_…) for the in-app checkout and payout setup forms
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret(s); for two destinations (your account + connected accounts) separate with a comma
STRIPE_WEBHOOK_SECRET=

# PayPal Payouts (optional: lets clippers be paid to PayPal or Venmo).
# Needs a PayPal Business account approved for Payouts and a REST app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# ID of the webhook you create for /api/webhooks/paypal (used to verify events)
PAYPAL_WEBHOOK_ID=

# Fee added on top of what streamers fund; clippers keep 100% of earnings
PLATFORM_FEE_PERCENT=9

# Shopify app secret (verifies orders/create webhooks)
SHOPIFY_WEBHOOK_SECRET=
